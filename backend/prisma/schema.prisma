// 人事考勤的数据模型。人以以虎 One 为准：Employee 是平台用户主数据的本地副本（id = 平台 user.id），
// 只多存平台没有的人事字段（入职日期、参加工作日期、档案）。
// 打卡、请假、出差、外出都以钉钉 / 飞书 / 企业微信为准，同步过来只读；本应用不再走请假审批（LeaveRequest 只留着旧数据）。
// 表结构改动要向前兼容（先加字段、后删字段）：平台回滚只回代码不回数据库。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// 员工：平台用户的本地副本（每小时从 /api/open/users 增量同步）+ 人事字段
model Employee {
  /// 平台 user.id
  id            Int       @id
  name          String    @db.VarChar(50)
  jobNumber     String?   @db.VarChar(50)
  title         String?   @db.VarChar(100)
  avatar        String?   @db.VarChar(500)
  spaceId       Int       @default(1)
  /// 主部门（平台部门 id 和完整路径）
  deptId        Int?
  deptPath      String?   @db.VarChar(300)
  /// 所在的全部部门 [{ id, name, path, isPrimary }]，path 是平台部门树拼出的完整路径（看下级部门用）
  depts         Json?
  /// 担任负责人的部门 id（来自统一登录的 leaderOf，本人登录过才有）
  leaderOf      Json?
  active        Boolean   @default(true)
  /// 三家的身份，用来对上打卡记录
  dingUserId    String?   @db.VarChar(64)
  feishuOpenId  String?   @db.VarChar(64)
  /// 飞书考勤接口只认 user_id（employee_id），由 open_id 换来后缓存在这里
  feishuUserId  String?   @db.VarChar(64)
  wecomUserId   String?   @db.VarChar(64)
  /// 人事字段：入职本单位日期、参加工作日期（算法定年假用）
  hireDate      DateTime? @db.Date
  workStartDate DateTime? @db.Date
  /// 旧版的指定审批人（0.3.0 起请假审批在钉钉 / 飞书 / 企业微信里走，不再用）
  approverId    Int?
  /// 档案（人事填，画像用）：用工类型 FULL_TIME 全职 / INTERN 实习 / PART_TIME 兼职 / OUTSOURCED 外包 / REHIRED 退休返聘
  employmentType String?  @db.VarChar(12)
  /// 转正日期、离职日期（离职日期用来算竞业限制期）
  regularDate   DateTime? @db.Date
  leaveDate     DateTime? @db.Date
  /// 职级（如 P5、M2，公司自己的写法）
  level         String?   @db.VarChar(20)
  /// M 男 / F 女
  gender        String?   @db.VarChar(1)
  birthDate     DateTime? @db.Date
  /// 学历：高中及以下 / 大专 / 本科 / 硕士 / 博士
  education     String?   @db.VarChar(10)
  school        String?   @db.VarChar(100)
  major         String?   @db.VarChar(100)
  /// 标签（技能、特长、关注点），字符串数组
  tags          Json?
  /// 考勤 / 考核豁免：空 = 正常；ATTENDANCE 免考勤（不进考勤统计，人员指标、成本照算）；
  /// FULL 免考勤、不参与考核（如董事：考勤统计、人员全景的指标和人员成本都不算）。名单、档案、成本表里照常有
  exemption     String?   @db.VarChar(10)
  /// 豁免原因（如「董事会成员」「外派」）
  exemptNote    String?   @db.VarChar(100)
  /// 上次从钉钉 / 飞书读到的档案：{ DINGTALK: { hireDate, gender, …, at }, FEISHU: {…} }。
  /// 三方比对用：钉钉上的值变了 → 更新这里；没变而这里改过 → 保留这里的（不来回覆盖）
  vendorSnapshot Json?
  syncedAt      DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([deptId])
  @@index([dingUserId])
  @@index([feishuOpenId])
  @@index([wecomUserId])
}

/// 应用内角色。平台管理员自动算人事（HR），不用登记
model RoleMember {
  userId    Int
  role      String   @db.VarChar(20)
  createdBy Int?
  createdAt DateTime @default(now())

  @@id([userId, role])
}

/// 打卡记录：三家各自的记录统一成一种形状。(source, externalId) 唯一，重复同步只会更新
model Punch {
  id         Int       @id @default(autoincrement())
  /// DINGTALK / FEISHU / WECOM / MANUAL
  source     String    @db.VarChar(10)
  externalId String    @db.VarChar(128)
  userId     Int
  /// 考勤日（按设置的时区），YYYY-MM-DD
  workDate   String    @db.VarChar(10)
  /// IN 上班 / OUT 下班 / OUTSIDE 外出
  kind       String    @db.VarChar(10)
  /// 实际打卡时间；缺卡时为空
  checkTime  DateTime?
  /// 应打卡时间（排班）
  planTime   DateTime?
  /// NORMAL / LATE / SERIOUS_LATE / EARLY / MISSING / ABSENT / LOCATION / OTHER
  result     String    @db.VarChar(16)
  location   String?   @db.VarChar(200)
  note       String?   @db.VarChar(500)
  /// 手工补录的人
  createdBy  Int?
  raw        Json?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([source, externalId])
  @@index([userId, workDate])
  @@index([workDate])
}

/// 每次同步的记录（设置页「同步状态」）
model SyncRun {
  id         Int       @id @default(autoincrement())
  /// DINGTALK / FEISHU / WECOM / DIRECTORY
  source     String    @db.VarChar(10)
  /// AUTO 定时 / MANUAL 手动
  trigger    String    @db.VarChar(10)
  dateFrom   String?   @db.VarChar(10)
  dateTo     String?   @db.VarChar(10)
  ok         Boolean?
  fetched    Int       @default(0)
  saved      Int       @default(0)
  /// 有平台账号但对不上这家身份的人数
  unmatched  Int       @default(0)
  /// 同步到的请假 / 出差 / 外出条数
  absences   Int       @default(0)
  /// 请假 / 出差 / 外出这一步：成功没有、拉的日期范围、出错信息（打卡成功、请假失败时 ok 仍是 true）
  absenceOk    Boolean?
  absenceFrom  String?  @db.VarChar(10)
  absenceTo    String?  @db.VarChar(10)
  absenceError String?  @db.Text
  error      String?   @db.Text
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([source, startedAt])
}

/// 假期类型
model LeaveType {
  code      String   @id @db.VarChar(20)
  name      String   @db.VarChar(30)
  /// 带薪
  paid      Boolean  @default(true)
  /// 要扣余额（年假、调休）；不扣余额的假只记天数
  balanced  Boolean  @default(false)
  /// 最小单位：DAY 整天 / HALF 半天
  unit      String   @default("HALF") @db.VarChar(5)
  active    Boolean  @default(true)
  sort      Int      @default(0)
  note      String?  @db.VarChar(200)
  updatedAt DateTime @updatedAt
}

/// 旧版（0.2.x）在本应用里提交的请假申请。0.3.0 起不再新增，已批准的照常算进考勤
model LeaveRequest {
  id           Int       @id @default(autoincrement())
  userId       Int
  typeCode     String    @db.VarChar(20)
  startDate    String    @db.VarChar(10)
  /// AM 上午开始 / PM 下午开始
  startHalf    String    @default("AM") @db.VarChar(2)
  endDate      String    @db.VarChar(10)
  /// AM 上午结束 / PM 下午结束
  endHalf      String    @default("PM") @db.VarChar(2)
  /// 工作日天数（扣掉周末和节假日），0.5 的倍数
  days         Decimal   @db.Decimal(6, 1)
  reason       String?   @db.VarChar(500)
  /// PENDING / APPROVED / REJECTED / CANCELLED
  status       String    @default("PENDING") @db.VarChar(10)
  approverId   Int?
  decidedBy    Int?
  decidedAt    DateTime?
  decisionNote String?   @db.VarChar(500)
  /// 经哪里提交：WEB / AI
  via          String    @default("WEB") @db.VarChar(5)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId, startDate])
  @@index([status, approverId])
  @@index([startDate, endDate])
}

/// 假期余额流水：余额 = 某人某年某类假的 delta 之和。只追加，不改不删，便于对账
model LeaveLedger {
  id        Int      @id @default(autoincrement())
  userId    Int
  year      Int
  typeCode  String   @db.VarChar(20)
  /// 正数增加，负数扣减（天）
  delta     Decimal  @db.Decimal(6, 1)
  /// GRANT 发放 / CARRY_OVER 上年结转 / ADJUST 调整 / IMPORT 导入（设为某个余额）/ USE 请假扣减 / RESTORE 撤销退回 / EXPIRE 清零
  kind      String   @db.VarChar(12)
  /// 旧版请假申请
  requestId Int?
  /// 同步来的请假（Absence）：扣减和退回按它对账
  absenceId Int?
  note      String?  @db.VarChar(300)
  createdBy Int?
  createdAt DateTime @default(now())

  @@index([userId, year, typeCode])
  @@index([requestId])
  @@index([absenceId])
}

/// 请假 / 出差 / 外出：从钉钉、飞书、企业微信同步来的已通过的假勤，只读。(source, externalId) 唯一，重复同步只会更新；
/// 重拉时各家已经没有了的（撤销了）标成 CANCELLED。对上「扣余额」的假期类型时自动扣 / 退余额
model Absence {
  id         Int       @id @default(autoincrement())
  /// DINGTALK / FEISHU / WECOM
  source     String    @db.VarChar(10)
  externalId String    @db.VarChar(128)
  userId     Int
  /// LEAVE 请假 / TRIP 出差 / OUT 外出
  category   String    @db.VarChar(8)
  /// 各家的名称（年假、事假、外出……）；钉钉的请假拿不到类型时为空
  typeName   String?   @db.VarChar(50)
  /// 按名称对上的本应用假期类型
  typeCode   String?   @db.VarChar(20)
  /// 起止时刻（企业微信按天给，没有）
  startAt    DateTime?
  endAt      DateTime?
  /// 考勤日 YYYY-MM-DD
  startDate  String    @db.VarChar(10)
  endDate    String    @db.VarChar(10)
  /// 各家报的时长（有哪个填哪个）
  days       Decimal?  @db.Decimal(6, 2)
  hours      Decimal?  @db.Decimal(7, 2)
  /// APPROVED 已通过 / CANCELLED 各家已经没有了（撤销）
  status     String    @default("APPROVED") @db.VarChar(10)
  approvalId String?   @db.VarChar(64)
  raw        Json?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([source, externalId])
  @@index([userId, startDate])
  @@index([startDate, endDate])
}

/// 节假日与调休上班日：HOLIDAY 放假（工作日也不上班）/ WORKDAY 调休上班（周末也上班）
model Holiday {
  date      String   @id @db.VarChar(10)
  kind      String   @db.VarChar(8)
  name      String?  @db.VarChar(50)
  updatedAt DateTime @updatedAt
}

/// 应用设置（人事在「设置」里改，即改即生效）
model Setting {
  key       String   @id @db.VarChar(64)
  value     Json
  updatedBy Int?
  updatedAt DateTime @updatedAt
}

/// 操作留痕
model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    Int?
  via        String   @db.VarChar(6)
  action     String   @db.VarChar(40)
  entityType String?  @db.VarChar(20)
  entityId   String?  @db.VarChar(40)
  detail     Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

/// 合同与协议：劳动合同、保密协议、竞业限制协议等，一人可有多份。续签 = 新建一份，renewOfId 指向上一份
model Contract {
  id              Int       @id @default(autoincrement())
  userId          Int
  /// LABOR 劳动合同 / CONFIDENTIALITY 保密协议 / NON_COMPETE 竞业限制 / IP 知识产权归属 / TRAINING 培训服务期 / INTERN 实习协议 / SERVICE 劳务协议 / OTHER 其他
  kind            String    @db.VarChar(16)
  title           String?   @db.VarChar(100)
  number          String?   @db.VarChar(50)
  /// FIXED 固定期限 / OPEN 无固定期限 / TASK 以完成一定工作任务为期限
  term            String    @default("FIXED") @db.VarChar(5)
  signedDate      String?   @db.VarChar(10)
  startDate       String    @db.VarChar(10)
  /// 固定期限必填；无固定期限为空
  endDate         String?   @db.VarChar(10)
  /// 劳动合同的试用期截止日
  probationEnd    String?   @db.VarChar(10)
  /// 竞业限制：期限（月，法定不超过 24）、每月补偿金；从离职日起算
  restrictMonths  Int?
  monthlyComp     Decimal?  @db.Decimal(12, 2)
  /// 培训服务期：服务期（月）、违约金上限
  serviceMonths   Int?
  penalty         Decimal?  @db.Decimal(12, 2)
  /// 签好的合同文件：以虎 One 文件存储里的 key（相对本应用目录）
  fileKey         String?   @db.VarChar(500)
  fileName        String?   @db.VarChar(200)
  fileSize        Int?
  renewOfId       Int?
  /// 提前解除 / 终止
  terminatedAt    String?   @db.VarChar(10)
  terminateReason String?   @db.VarChar(300)
  note            String?   @db.VarChar(1000)
  createdBy       Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@index([userId, kind])
  @@index([endDate])
}

/// 每人每月的标准成本（人事填），「生成某月成本」按它填成本表
model CostProfile {
  userId    Int      @id
  /// 月应发工资（基本 + 绩效 + 津贴）
  salary    Decimal  @default(0) @db.Decimal(12, 2)
  /// 社保、公积金的单位部分
  social    Decimal  @default(0) @db.Decimal(12, 2)
  housing   Decimal  @default(0) @db.Decimal(12, 2)
  /// 福利（餐补、交通、商业保险等）
  benefit   Decimal  @default(0) @db.Decimal(12, 2)
  note      String?  @db.VarChar(300)
  updatedBy Int?
  updatedAt DateTime @updatedAt
}

/// 成本表：某人某月某类成本一个数（再录一次是改，不是加）
model CostItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  /// YYYY-MM
  month     String   @db.VarChar(7)
  /// SALARY 工资 / BONUS 奖金 / SOCIAL 社保 / HOUSING 公积金 / BENEFIT 福利 / TRAINING 培训 / EQUIPMENT 设备办公 / RECRUIT 招聘 / NON_COMPETE 竞业补偿 / SEVERANCE 经济补偿 / OTHER 其他
  category  String   @db.VarChar(12)
  amount    Decimal  @db.Decimal(12, 2)
  /// MANUAL 手填 / IMPORT 导入 / PROFILE 按标准生成 / CONTRACT 按竞业协议生成
  source    String   @default("MANUAL") @db.VarChar(8)
  note      String?  @db.VarChar(300)
  updatedBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, month, category])
  @@index([month])
}

/// 1v1 记录：负责人（或人事）和某位同事的一次 1v1
model OneOnOne {
  id          Int       @id @default(autoincrement())
  userId      Int
  /// 谁谈的（记录人）
  managerId   Int
  date        String    @db.VarChar(10)
  minutes     Int?
  /// 状态 1 ~ 5（1 很差、3 一般、5 很好）
  mood        Int?
  /// 话题：字符串数组（工作进展、目标、成长、困难、反馈、职业发展、团队、生活……）
  topics      Json?
  /// 谈话纪要：shared 时本人也能看
  notes       String?   @db.Text
  /// 只有记录人和人事能看
  privateNote String?   @db.Text
  /// 待办 [{ text, owner: EMPLOYEE | MANAGER, due, done }]
  actions     Json?
  nextDate    String?   @db.VarChar(10)
  shared      Boolean   @default(true)
  /// 导入的会议纪要：原文件（以虎 One 文件存储，key 固定是 one-on-ones/<userId>/…）、识别出的全文、模型解析的结果
  sourceFileKey  String?  @db.VarChar(500)
  sourceFileName String?  @db.VarChar(200)
  sourceFileSize Int?
  /// 纪要全文（从文件里抽出来的或粘贴的）；记录人、上级、人事能看，本人只在 sourceShared 时能看
  sourceText     String?  @db.MediumText
  sourceShared   Boolean  @default(false)
  /// 解析结果 { summary, topics, actions, mood, moodReason, nextDate, observations, by: AI | RULE, at }，留着对照
  parsed         Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([userId, date])
  @@index([managerId, date])
}

/// 同步时「已经查过、不用再查」的东西（钉钉按审批实例逐个补查出差 / 外出、请假类型，查过的记下来，省接口调用量）
model SyncSeen {
  source    String   @db.VarChar(10)
  key       String   @db.VarChar(128)
  createdAt DateTime @default(now())

  @@id([source, key])
}

/// 导入时确认过的别名：表里写的「郭老师」「顾一（产品）」= 哪个人。下次导入直接认，不用再确认
model NameAlias {
  alias     String   @id @db.VarChar(50)
  userId    Int
  createdBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// 从钉钉 / 飞书补全档案时的改动和冲突：APPLIED 已按钉钉 / 飞书更新；CONFLICT 第一次比对两边不一样，等人事选；
/// RESOLVED 人事选过了（resolution：VENDOR 用钉钉 / 飞书的 / APP 保留这里的）
model ProfileChange {
  id         Int       @id @default(autoincrement())
  userId     Int
  source     String    @db.VarChar(10)
  field      String    @db.VarChar(20)
  before     String?   @db.VarChar(200)
  after      String?   @db.VarChar(200)
  kind       String    @db.VarChar(10)
  resolution String?   @db.VarChar(6)
  resolvedBy Int?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([kind, createdAt])
  @@index([userId])
}

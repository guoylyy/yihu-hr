# 本地开发用。装在以虎 One 上时 DATABASE_URL、PORT、YH_* 由平台注入，不用写。
DATABASE_URL=mysql://root:root123456@127.0.0.1:3306/yihu_hr_dev
PORT=3006

# 不配 YH_CLIENT_ID 时是本地开发模式：不走统一登录，以 DEV_USER_ID 这个人的身份访问（DEV_ADMIN=1 当平台管理员）
DEV_USER_ID=1
DEV_ADMIN=1
# 当哪些平台部门（id，逗号分隔）的负责人，试团队考勤用
DEV_LEADER_OF=

# ---- 打卡来源（只配要用的那家；服务器上写进 apps/hr/.env，不要进代码库）----
# 钉钉：企业内部应用的 AppKey / AppSecret，开通「考勤」读权限（建议和平台登录用同一个应用）
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
# 飞书：企业自建应用，必须和平台「登录方式」里的是同一个应用（open_id 才对得上）；
# 开通「导出打卡数据」attendance:task:readonly 和「获取用户 user ID」contact:user.employee_id:readonly
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 企业微信：企业 ID + 「打卡」系统应用的 Secret（不是平台登录用的自建应用 Secret）
WECOM_CORP_ID=
WECOM_CHECKIN_SECRET=
